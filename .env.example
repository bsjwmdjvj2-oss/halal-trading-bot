# Alpaca paper trading credentials
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# PythonAnywhere API -- optional, only needed for the Telegram /restart
# command (halal_bot/telegram/pythonanywhere_client.py), which restarts the
# Always-on Task running this bot after a `git pull` deploy. Token from
# https://www.pythonanywhere.com/account/#api_token. Leave blank to skip;
# /restart will reply with a config-error message instead of doing anything.
PYTHONANYWHERE_API_TOKEN=
PYTHONANYWHERE_USERNAME=

# TradeVant dashboard auto-refresh endpoint (pythonanywhere_dashboard_app.py)
# -- a shared secret the /dashboard-data route checks via ?token=. Deployed
# as a PythonAnywhere Web App, separate from the Always-on Task/Scheduled
# Task. Set this to the SAME value in that Web App's own env config (its
# WSGI file, since PythonAnywhere Web Apps don't read this repo's .env).
DASHBOARD_API_TOKEN=

# AI summary agent (Section 8) — only needed once that layer is wired up
ANTHROPIC_API_KEY=

# Set to "true" only once you've reviewed several dry-run logs from
# scripts/run_daily.py and are ready for it to submit real (paper) orders.
LIVE_TRADING_ENABLED=false

# Halal Terminal (halal_bot/screening/halal_terminal_client.py) — optional,
# professional multi-methodology Shariah screen used as a cross-check in the
# quarterly research step only (not the live monthly re-screen). Get this
# from your Halal Terminal account; leave blank to skip the cross-check.
HT_API_KEY=
HT_API_BASE_URL=https://api.halalterminal.com

# TipRanks' official MCP-over-HTTP server -- real, unattended API-key access
# for scripts/refresh_tipranks.py (scheduled every ~5 days), replacing the
# old chat-session-only manual snapshot refresh. Get a key at
# mcp.tipranks.com; free tier is 100 calls/month for Premium/Ultimate
# TipRanks subscribers (50 otherwise). Leave blank to skip and fall back to
# the manual chat-session refresh.
TIPRANKS_API_KEY=
TIPRANKS_API_BASE_URL=https://mcp.tipranks.com
